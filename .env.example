# ─────────────────────────────────────────────────────────────────────────────
# Lumos environment. Copy to .env and fill in.
# .env is gitignored and must never be committed.
#
# Rule (ADR-012): no secret has a default value. A missing REQUIRED variable
# aborts startup with a clear error rather than falling back silently.
#
# Columns below each variable: purpose · required? · used by · dev · prod
# ─────────────────────────────────────────────────────────────────────────────

# ── Application ──────────────────────────────────────────────────────────────
NODE_ENV=development
# purpose: environment switch · required: yes · used by: web, api
# dev: development · prod: production

APP_URL=http://localhost:3000
# purpose: public web origin; OAuth redirects, absolute links
# required: yes · used by: web, api · prod: the real domain

API_URL=http://localhost:8000
# purpose: FastAPI origin the web app calls (server-side)
# required: yes · used by: web

# ── Database ─────────────────────────────────────────────────────────────────
DATABASE_URL=
# purpose: Neon Postgres connection (pooled). pgvector extension required.
# required: yes · used by: api, ingestion, migrations
# dev: local Postgres container is fine · prod: Neon pooled URL

DIRECT_DATABASE_URL=
# purpose: unpooled connection for migrations
# required: yes in prod · used by: migrations

# ── Authentication ───────────────────────────────────────────────────────────
AUTH_SECRET=
# purpose: session/token signing. Generate: python -c "import secrets;print(secrets.token_hex(32))"
# required: yes · used by: api
# NO DEFAULT. Startup aborts if unset — the legacy app fell back to a public
# string, which is a session-forgery path to any account.

# ── Model gateway ────────────────────────────────────────────────────────────
AI_PROVIDER=mock
# purpose: which provider the gateway uses · required: yes · used by: api, ingestion
# values: mock | huggingface | ollama | render
# ollama = generate locally, embed on Hugging Face (see SplitProvider).
#          Needs HF_TOKEN as well: the corpus is indexed with bge-m3.
# dev: mock (deterministic, no credentials, what CI uses) · prod: huggingface or render

AI_API_URL=
# purpose: provider endpoint. SERVER-SIDE ONLY — never exposed to the browser.
# required: yes unless AI_PROVIDER=mock · used by: api

AI_API_KEY=
# purpose: provider credential. SERVER-SIDE ONLY.
# required: yes unless AI_PROVIDER=mock · used by: api

CHAT_MODEL=gemma4:e4b
# purpose: generation model id · required: yes unless mock
#
# gemma4:e4b IS THE ONLY GENERATION MODEL LUMOS USES. Not a default — a policy.
# Provider mapping for the same model:
#     ollama       gemma4:e4b
#     huggingface  google/gemma-4-E4B-it   (Apache-2.0)
# No Qwen, no Gemini, no GPT, and no fallback chain to a second generation
# model. If gemma4:e4b is unavailable the gateway fails loudly; answering from
# a different model would silently change what the tutor is.
#
# Two models are exempt, because a decoder LLM cannot do their jobs:
# EMBEDDING_MODEL below (no embedding endpoint) and RERANKER_MODEL below
# (cross-encoder scoring of a query-document pair). See ARCHITECTURE.md.

VISION_MODEL=
# purpose: image/document understanding · required: only if ENABLE_VISION=true
# Phase 2. When it arrives it is gemma4:e4b's own multimodal capability, not a
# separate vision model.

EMBEDDING_MODEL=BAAI/bge-m3
# purpose: multilingual embeddings, 1024-dim · required: yes
# Do not substitute — the Bangla/English retrieval design depends on this model.

RERANKER_MODEL=BAAI/bge-reranker-v2-m3
# purpose: cross-encoder reranking · required: yes

# ── Hugging Face ─────────────────────────────────────────────────────────────
HF_TOKEN=
# purpose: embeddings and reranking over HF Inference; gated model access
# required: yes for retrieval, INCLUDING when AI_PROVIDER=ollama — the corpus is
# indexed with bge-m3, and embedding queries with another model would put query
# and document vectors in different spaces.
# Needs the `inference.serverless.write` scope.
# Get from https://huggingface.co/settings/tokens

# ── Local inference ──────────────────────────────────────────────────────────
OLLAMA_URL=http://127.0.0.1:11434
# purpose: local Ollama serving gemma4:e4b · required: only if AI_PROVIDER=ollama
# `ollama pull gemma4:e4b` then `ollama serve`. Verify the tag with
# `ollama show gemma4:e4b` and record what it resolves to (BLOCK-005).

RERANK_ENABLED=
# purpose: turn cross-encoder reranking back on · required: no
# OFF by default, and that is a measurement. Reranking via HF serverless made
# known-item retrieval 19x worse at rank 1 (recall@1 1.000 -> 0.053), because
# the reachable pipeline computes bi-encoder cosine rather than cross-encoder
# scores. Set to 1 only with a real cross-encoder endpoint, and re-measure.

# ── Retrieval tuning ─────────────────────────────────────────────────────────
RETRIEVAL_TOP_N=30
# purpose: candidates fetched from EACH retriever before fusion · required: no

RRF_K=60
# purpose: RRF rank constant (ADR-007) · required: no

RRF_WEIGHT_DENSE_EN=0.6
RRF_WEIGHT_SPARSE_EN=0.4
RRF_WEIGHT_DENSE_BN=0.4
RRF_WEIGHT_SPARSE_BN=0.6
# purpose: language-aware fusion weights, carried from the legacy implementation.
# required: no. These are the BASELINE to beat on a measured golden set,
# not a tuned result. Re-derive once LUMOS-004E exists.

RERANK_CANDIDATES=20
# purpose: fused candidates passed to the cross-encoder · required: no

CONFIDENCE_THRESHOLD=0.3
# purpose: minimum reranker score to treat an answer as grounded · required: no
# Below this the tutor states a limitation instead of answering.
# Calibrate per corpus once evaluation data exists.

# ── Cloudflare / R2 ──────────────────────────────────────────────────────────
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=
# purpose: DNS/CDN/Workers management · required: for deployment
# Use a SCOPED token, never a global API key.

R2_BUCKET_NAME=
R2_ENDPOINT=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
# purpose: curriculum page images, 3D/video assets, exports, uploads
# required: for ingestion of image-bearing sources and for LUMOS-017

# ── Observability ────────────────────────────────────────────────────────────
SENTRY_DSN=
# purpose: error monitoring · required: no · dev: leave blank to disable

LOG_LEVEL=info
# purpose: structured log verbosity · required: no

# ── Email ────────────────────────────────────────────────────────────────────
EMAIL_API_KEY=
EMAIL_FROM=
# purpose: account verification, password reset · required: once auth ships
# Provider not yet decided (BLOCK-006). Gmail SMTP app passwords, used by the
# legacy app, are not production-grade.

# ── Feature flags ────────────────────────────────────────────────────────────
ENABLE_VOICE=false
ENABLE_VISION=false
ENABLE_3D_HOME=true
# purpose: staged rollout · required: no

# ── Future ───────────────────────────────────────────────────────────────────
# PAYMENTS_*  — not yet needed. Do not add variables speculatively:
# every variable must have a purpose, a required/optional status, a consumer,
# and documented dev and prod behaviour before it is added here.
